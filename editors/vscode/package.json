{
  "name": "nodx-language",
  "displayName": "NODX Language Support",
  "description": "Syntax highlighting for NODX 1.0 documents.",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "nodx",
  "repository": {
    "type": "git",
    "url": "https://github.com/asterd/nodx.git",
    "directory": "editors/vscode"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "language-configuration.json",
    "package.json",
    "snippets/**",
    "syntaxes/**"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "nodx",
        "aliases": ["NODX", "nodx"],
        "extensions": [".nodx"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nodx",
        "scopeName": "source.nodx",
        "path": "./syntaxes/nodx.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "nodx",
        "path": "./snippets/nodx.code-snippets"
      }
    ]
  }
}
