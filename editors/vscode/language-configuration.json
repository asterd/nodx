{
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^`~!@$%^&*()=+\\[{\\]}\\\\|;:'\",.<>/?\\s]+)",
  "folding": {
    "markers": {
      "start": "^::+[A-Za-z][A-Za-z0-9-]*(?:\\s+\\{[^}]*\\})?$",
      "end": "^::+(?:\\s+[A-Za-z][A-Za-z0-9-]*)?$"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^::+[A-Za-z][A-Za-z0-9-]*(?:\\s+\\{[^}]*\\})?$",
    "decreaseIndentPattern": "^::+(?:\\s+[A-Za-z][A-Za-z0-9-]*)?$"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"],
    ["`", "`"]
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"],
    ["`", "`"]
  ]
}
