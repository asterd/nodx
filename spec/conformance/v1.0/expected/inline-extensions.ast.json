{"body":[{"attrs":{"level":"1"},"children":[],"classes":[],"id":"inline","inlines":[{"text":"Inline extensions","type":"text"}],"text":null,"type":"heading"},{"attrs":{},"children":[],"classes":[],"id":null,"inlines":[{"text":"Underscore emphasis applies at word boundaries: ","type":"text"},{"children":[{"text":"em","type":"text"}],"type":"em"},{"text":" and ","type":"text"},{"children":[{"text":"strong","type":"text"}],"type":"strong"},{"text":" work\njust like ","type":"text"},{"children":[{"text":"em","type":"text"}],"type":"em"},{"text":" and ","type":"text"},{"children":[{"text":"strong","type":"text"}],"type":"strong"},{"text":".","type":"text"}],"text":null,"type":"paragraph"},{"attrs":{},"children":[],"classes":[],"id":null,"inlines":[{"text":"Intraword underscores stay literal because the run is flanked by\nalphanumerics on both sides. Examples: snake_case identifiers, my_var_name\nreferences, and snake__case patterns are preserved as plain text.","type":"text"}],"text":null,"type":"paragraph"},{"attrs":{},"children":[],"classes":[],"id":null,"inlines":[{"text":"Code spans support runs of one, two, or three backticks: ","type":"text"},{"text":"single","type":"code"},{"text":", ","type":"text"},{"text":"two ` ticks","type":"code"},{"text":",\nand ","type":"text"},{"text":"three backticks `` two `` runs","type":"code"},{"text":" inside.","type":"text"}],"text":null,"type":"paragraph"},{"attrs":{},"children":[],"classes":[],"id":null,"inlines":[{"text":"Backslash escapes the extended set: _underscore_, !bang, .dot, -dash,\n+plus, <less, >greater, \\backslash, \"quote\", 'apos'.","type":"text"}],"text":null,"type":"paragraph"},{"attrs":{},"children":[],"classes":[],"id":null,"inlines":[{"text":"Hard line break with backslash: first half","type":"text"},{"type":"line-break"},{"text":"second half on the next line.","type":"text"}],"text":null,"type":"paragraph"}],"meta":{"dir":"auto","language":"und","schema":"nodx/1.0","title":"Inline extensions","type":"document"},"schema":"nodx/1.0"}
