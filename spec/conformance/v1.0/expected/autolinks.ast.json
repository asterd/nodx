{"body":[{"attrs":{"level":"1"},"children":[],"classes":[],"id":"autolinks","inlines":[{"text":"Autolinks","type":"text"}],"text":null,"type":"heading"},{"attrs":{},"children":[],"classes":[],"id":null,"inlines":[{"text":"Absolute URI autolinks are parsed identically to ","type":"text"},{"text":"[label](target)","type":"code"},{"text":" links and\nrouted through the URL policy. Safe schemes pass: ","type":"text"},{"label":[{"text":"https://example.com","type":"text"}],"target":"https://example.com","type":"link"},{"text":" and\n","type":"text"},{"label":[{"text":"mailto:foo@bar.com","type":"text"}],"target":"mailto:foo@bar.com","type":"link"},{"text":" become standard links.","type":"text"}],"text":null,"type":"paragraph"},{"attrs":{},"children":[],"classes":[],"id":null,"inlines":[{"text":"Bare email autolinks acquire a ","type":"text"},{"text":"mailto:","type":"code"},{"text":" scheme so they are gated by the\nsame allowlist: ","type":"text"},{"label":[{"text":"foo@bar.com","type":"text"}],"target":"mailto:foo@bar.com","type":"link"},{"text":".","type":"text"}],"text":null,"type":"paragraph"},{"attrs":{},"children":[],"classes":[],"id":null,"inlines":[{"text":"Full URLs with path, query, and fragment survive verbatim:\n","type":"text"},{"label":[{"text":"https://example.com/path?q=1#frag","type":"text"}],"target":"https://example.com/path?q=1#frag","type":"link"},{"text":".","type":"text"}],"text":null,"type":"paragraph"},{"attrs":{},"children":[],"classes":[],"id":null,"inlines":[{"text":"Disambiguation: ","type":"text"},{"text":"<not a url>","type":"code"},{"text":" contains whitespace and stays literal text;\nthe empty form ","type":"text"},{"text":"<>","type":"code"},{"text":" is never an autolink either.","type":"text"}],"text":null,"type":"paragraph"},{"attrs":{},"children":[],"classes":[],"id":null,"inlines":[{"text":"Multiple autolinks on one paragraph parse independently:\n","type":"text"},{"label":[{"text":"https://a.example.com","type":"text"}],"target":"https://a.example.com","type":"link"},{"text":" followed by text and ","type":"text"},{"label":[{"text":"mailto:other@example.com","type":"text"}],"target":"mailto:other@example.com","type":"link"},{"text":".","type":"text"}],"text":null,"type":"paragraph"}],"meta":{"dir":"auto","language":"und","schema":"nodx/1.0","title":"Autolinks","type":"document"},"schema":"nodx/1.0"}
